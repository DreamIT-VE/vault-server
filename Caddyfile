# Caddyfile for Vaultwarden

vault.dreamit.software {
  encode zstd gzip

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
  }
}

estudiocivic.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=15768000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Cross-Origin-Resource-Policy "same-origin"
    Reporting-Endpoints "csp-endpoint=\"/csp-report-endpoint\""
    # Enforced CSP — explicit whitelists for third-party hosts; keep 'unsafe-inline' while we phase it out
    Content-Security-Policy "default-src 'self' https: 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.instagram.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https://dreamit-assets-worker.oaba-dev.workers.dev https://simpleicons.org https://scontent.cdninstagram.com; style-src 'self' 'unsafe-inline'; font-src 'self' https:; frame-src https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-to csp-endpoint; report-uri /csp-report-endpoint"

    # Report-only CSP: deny-by-default (default-src 'none') — use this to collect violations safely before enforcing
    Content-Security-Policy-Report-Only "default-src 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.instagram.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https://dreamit-assets-worker.oaba-dev.workers.dev https://simpleicons.org https://scontent.cdninstagram.com; media-src 'self' https://dreamit-assets-worker.oaba-dev.workers.dev; style-src 'self' 'unsafe-inline'; font-src 'self' https:; frame-src https://www.instagram.com; frame-ancestors 'self'; report-to csp-endpoint; report-uri /csp-report-endpoint"
  }

  # lightweight endpoint to collect CSP reports (responds 204)
  handle_path /csp-report-endpoint {
    respond 204
  }

  reverse_proxy frontend:3005
}

smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy frontend:3000 {
    header_up X-Real-IP {remote_host}
  }
}

api.smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy nginx:80  {
    header_up X-Real-IP {remote_host}
  }
}