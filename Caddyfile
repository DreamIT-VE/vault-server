# Caddyfile for Vaultwarden

vault.dreamit.software {
  encode zstd gzip

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
  }
}

estudiocivic.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=15768000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Cross-Origin-Resource-Policy "same-origin"
    Reporting-Endpoints "csp-endpoint=\"/csp-report-endpoint\""
    # Enforced CSP — deny-by-default with explicit whitelists for required hosts
    Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-9GM0j21aBt53QDQjXz+UaUr2C+oOcbwQ0616VyuL890=' 'sha256-1cxJGCTrsf+jdLoFl6c/qabV8GMPfxHskb5UHPSes4o=' https://www.googletagmanager.com https://www.instagram.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https://dreamit-assets-worker.oaba-dev.workers.dev https://simpleicons.org https://scontent.cdninstagram.com; media-src 'self' https://dreamit-assets-worker.oaba-dev.workers.dev; style-src 'self' 'unsafe-inline'; font-src 'self' https:; frame-src https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-to csp-endpoint; report-uri /csp-report-endpoint"

    # Report-only CSP: deny-by-default (default-src 'none') — use this to collect violations safely before enforcing
    Content-Security-Policy-Report-Only "default-src 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'sha256-9GM0j21aBt53QDQjXz+UaUr2C+oOcbwQ0616VyuL890=' 'sha256-1cxJGCTrsf+jdLoFl6c/qabV8GMPfxHskb5UHPSes4o=' https://www.googletagmanager.com https://www.instagram.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https://dreamit-assets-worker.oaba-dev.workers.dev https://simpleicons.org https://scontent.cdninstagram.com; media-src 'self' https://dreamit-assets-worker.oaba-dev.workers.dev; style-src 'self' 'unsafe-inline'; font-src 'self' https:; frame-src https://www.instagram.com; frame-ancestors 'self'; report-to csp-endpoint; report-uri /csp-report-endpoint"
  }

  # lightweight endpoint to collect CSP reports (responds 204)
  handle_path /csp-report-endpoint {
    respond 204
  }

  reverse_proxy frontend:3005
}

smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy frontend:3000 {
    header_up X-Real-IP {remote_host}
  }
}

api.smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy nginx:80  {
    header_up X-Real-IP {remote_host}
  }
}
