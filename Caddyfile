# Caddyfile for Vaultwarden

vault.dreamit.software {
  encode zstd gzip

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
  }
}

estudiocivic.com {
  reverse_proxy frontend:3005
}

smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy frontend:3000 {
    header_up X-Real-IP {remote_host}
  }
}

api.smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy nginx:80  {
    header_up X-Real-IP {remote_host}
  }
}
