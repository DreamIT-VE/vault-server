# Caddyfile for Vaultwarden

vault.dreamit.software {
  encode zstd gzip

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
  }
}

estudiocivic.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=3600; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Cross-Origin-Resource-Policy "same-origin"
    # Report-only CSP — start in report-only to collect violations safely
    Content-Security-Policy-Report-Only "default-src 'self' https: 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; img-src 'self' data: https://dreamit-assets-worker.oaba-dev.workers.dev; style-src 'self' 'unsafe-inline'; font-src 'self' https:; frame-ancestors 'self'; report-uri /csp-report-endpoint"
  }

  # lightweight endpoint to collect CSP reports (responds 204)
  handle_path /csp-report-endpoint {
    respond 204
  }

  reverse_proxy frontend:3005
}

smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy frontend:3000 {
    header_up X-Real-IP {remote_host}
  }
}

api.smarterselfstorage.net {
  encode zstd gzip

  reverse_proxy nginx:80  {
    header_up X-Real-IP {remote_host}
  }
}
